root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
max_line_length = 120
indent_style = tabs

[package.json]
indent_style = space
indent_size = 2

[*.{md,mdx}]
# because some things like list indentation need to be spaced more weirdly
indent_style = space

[*.yml]
indent_style = space
indent_size = 2
